{
  "name": "koharu-vue-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "bun run article:check && vue-tsc --noEmit && vite build",
    "article:check": "bun scripts/articles.ts check",
    "article:publish": "bun scripts/articles.ts publish",
    "article:verify": "bun run test:articles && bun run build",
    "test:articles": "vitest run tests/article-content.test.ts tests/article-drafts.test.ts tests/article-editor-state.test.ts tests/article-publication.test.ts tests/article-catalog.test.ts tests/posts.test.ts tests/recommendations.test.ts tests/id.test.ts",
    "build:report": "bun run build && bun scripts/build-report.ts",
    "preview": "vite preview",
    "cf:build": "bun install --frozen-lockfile && bun run article:verify",
    "cf:dev": "bun run build && wrangler dev",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/check",
    "cf:deploy": "bun run article:verify && wrangler deploy --keep-vars",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6",
    "@fortawesome/free-brands-svg-icons": "6",
    "@fortawesome/free-regular-svg-icons": "6",
    "@fortawesome/free-solid-svg-icons": "6",
    "@fortawesome/vue-fontawesome": "3",
    "@meteor-icons/vue": "^4.5.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-unique-id": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.2.5",
    "less": "^4.9.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.0"
  }
}
