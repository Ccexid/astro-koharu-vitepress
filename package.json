{
  "name": "koharu-vue-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:report": "bun run build && bun scripts/build-report.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6",
    "@fortawesome/free-brands-svg-icons": "6",
    "@fortawesome/free-regular-svg-icons": "6",
    "@fortawesome/free-solid-svg-icons": "6",
    "@fortawesome/vue-fontawesome": "3",
    "@meteor-icons/vue": "^4.5.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "less": "^4.9.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
